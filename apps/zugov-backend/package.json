{
  "name": "@zugov/backend",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:backfill-eligible-tier-ids": "tsx src/db/backfillFormalizedEligibleTierIds.ts",
    "test": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@pcd/passport-interface": "0.15.1",
    "@pcd/zuauth": "1.8.1",
    "openac-sdk": "0.3.0",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "drizzle-kit": "^0.28.0",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.0",
    "siwe": "^2.3.2",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0"
  }
}
