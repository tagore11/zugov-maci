# Copy this to scripts/.env and fill in your values.
# scripts/.env is gitignored — never commit real secrets.

# Optional: Postgres connection string. If unset, dev.sh bootstraps a disposable
# local Postgres + neon-http proxy in Docker and uses that instead. Only set
# this to point at a real (e.g. Neon-hosted) database.
# DATABASE_URL=

# Required (first run only): funded Sepolia wallet private key (0x-prefixed).
# Used to deploy ZuGovRegistry. Once apps/zugov-frontend/src/generated/sepolia.ts
# has a non-zero registryAddress this is unused and can be left blank.
PRIVATE_KEY=
