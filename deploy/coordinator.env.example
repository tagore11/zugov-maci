# Copy to deploy/coordinator.env on the server and fill in the real value.
# Never commit deploy/coordinator.env (covered by .gitignore's deploy/*.env pattern).
#
# This is the ONLY place the real MACI vote-decryption key should ever live. It must never be
# passed through deploy/.env (read by other, less-sensitive services), committed, logged, or
# pasted into a chat/AI session — treat any exposure of this value as a compromise requiring
# rotation (regenerating the keypair and updating every community's coordinatorPublicKey that
# used it, which is why this file is separate from deploy/.env in the first place).

# The coordinator's own MACI private key (macisk.…) — pairs with the coordinatorPublicKey
# already registered on-chain via ZuGovRegistry.getInfrastructure().
COORDINATOR_MACI_PRIVATE_KEY=
