# Copy to deploy/.env on the server and fill in real values. Never commit deploy/.env.
#
# TLS/domain routing is handled by the host's nginx (see deploy/nginx-api.conf), not by this
# compose file — the backend only binds to 127.0.0.1:3002, which nginx reverse-proxies to.

# Postgres password for the self-hosted DB (pick a strong random value).
POSTGRES_PASSWORD=

# The frontend's origin (Vercel production URL, or a custom domain if you set one up).
CORS_ORIGIN=https://your-frontend.vercel.app

SCROLL_SEPOLIA_RPC_URL=https://sepolia-rpc.scroll.io
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Postgres password for graph-node's own DB (separate instance/volume from the
# backend's — pick a different strong random value).
GRAPH_POSTGRES_PASSWORD=
