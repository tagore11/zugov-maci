# Copy to deploy/.env on the server and fill in real values. Never commit deploy/.env.

# The subdomain pointed at this server's IP (A record), e.g. api.yourdomain.com.
# Caddy uses this to request a Let's Encrypt certificate automatically.
DOMAIN=

# Postgres password for the self-hosted DB (pick a strong random value).
POSTGRES_PASSWORD=

# The frontend's origin (Vercel production URL, or a custom domain if you set one up).
CORS_ORIGIN=https://your-frontend.vercel.app

SCROLL_SEPOLIA_RPC_URL=https://sepolia-rpc.scroll.io
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
